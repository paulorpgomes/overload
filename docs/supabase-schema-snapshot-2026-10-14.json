  "functions": [
    {
      "name": "cascade_workout_date",
      "definition": "CREATE OR REPLACE FUNCTION public.cascade_workout_date()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\nbegin\r\n  if new.performed_on is distinct from old.performed_on then\r\n    update public.workout_sets\r\n       set performed_on = new.performed_on\r\n     where workout_id = new.id;\r\n  end if;\r\n  return new;\r\nend;\r\n$function$\n"
    },
    {
      "name": "daily_nutrition",
      "definition": "CREATE OR REPLACE FUNCTION public.daily_nutrition(p_day date DEFAULT CURRENT_DATE)\n RETURNS TABLE(calories numeric, protein_g numeric, carb_g numeric, fat_g numeric)\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\r\n  select\r\n    coalesce(sum(i.calories), 0),\r\n    coalesce(sum(i.protein_g), 0),\r\n    coalesce(sum(i.carb_g), 0),\r\n    coalesce(sum(i.fat_g), 0)\r\n  from public.meal_items i\r\n  join public.meals m on m.id = i.meal_id\r\n  where m.user_id = (select auth.uid())\r\n    and m.eaten_on = p_day;\r\n$function$\n"
    },
    {
      "name": "exercise_progression",
      "definition": "CREATE OR REPLACE FUNCTION public.exercise_progression(p_exercise_id uuid, p_limit integer DEFAULT 30)\n RETURNS TABLE(performed_on date, top_weight_kg numeric, est_one_rm numeric, total_volume_kg numeric, total_sets bigint, total_reps bigint)\n LANGUAGE sql\n STABLE\n SET search_path TO ''\nAS $function$\r\n  select\r\n    s.performed_on,\r\n    max(s.weight_kg) as top_weight_kg,\r\n    round(max(s.weight_kg * (1 + s.reps::numeric / 40)), 1) as est_one_rm,\r\n    sum(s.weight_kg * s.reps) as total_volume_kg,\r\n    count(*) as total_sets,\r\n    sum(s.reps)::bigint as total_reps\r\n  from public.workout_sets s\r\n  where s.exercise_id = p_exercise_id\r\n    and s.user_id = (select auth.uid())\r\n    and not s.is_warmup\r\n  group by s.performed_on\r\n  order by s.performed_on desc\r\n  limit greatest(p_limit, 1);\r\n$function$\n"
    },
    {
      "name": "handle_new_user",
      "definition": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\nbegin\r\n  insert into public.profiles (id, full_name, avatar_url)\r\n  values (\r\n    new.id,\r\n    coalesce(\r\n      new.raw_user_meta_data ->> 'full_name',\r\n      new.raw_user_meta_data ->> 'name'\r\n    ),\r\n    coalesce(\r\n      new.raw_user_meta_data ->> 'avatar_url',\r\n      new.raw_user_meta_data ->> 'picture'\r\n    )\r\n  )\r\n  on conflict (id) do nothing;\r\n  return new;\r\nend;\r\n$function$\n"
    },
    {
      "name": "rls_auto_enable",
      "definition": "CREATE OR REPLACE FUNCTION public.rls_auto_enable()\n RETURNS event_trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$\nDECLARE\n  cmd record;\nBEGIN\n  FOR cmd IN\n    SELECT *\n    FROM pg_event_trigger_ddl_commands()\n    WHERE command_tag IN ('CREATE TABLE', 'CREATE TABLE AS', 'SELECT INTO')\n      AND object_type IN ('table','partitioned table')\n  LOOP\n     IF cmd.schema_name IS NOT NULL AND cmd.schema_name IN ('public') AND cmd.schema_name NOT IN ('pg_catalog','information_schema') AND cmd.schema_name NOT LIKE 'pg_toast%' AND cmd.schema_name NOT LIKE 'pg_temp%' THEN\n      BEGIN\n        EXECUTE format('alter table if exists %s enable row level security', cmd.object_identity);\n        RAISE LOG 'rls_auto_enable: enabled RLS on %', cmd.object_identity;\n      EXCEPTION\n        WHEN OTHERS THEN\n          RAISE LOG 'rls_auto_enable: failed to enable RLS on %', cmd.object_identity;\n      END;\n     ELSE\n        RAISE LOG 'rls_auto_enable: skip % (either system schema or not in enforced list: %.)', cmd.object_identity, cmd.schema_name;\n     END IF;\n  END LOOP;\nEND;\n$function$\n"
    },
    {
      "name": "sync_meal_item_user",
      "definition": "CREATE OR REPLACE FUNCTION public.sync_meal_item_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\nbegin\r\n  select m.user_id into new.user_id\r\n    from public.meals m\r\n   where m.id = new.meal_id;\r\n\r\n  if not found then\r\n    raise exception 'meal % not found', new.meal_id;\r\n  end if;\r\n\r\n  return new;\r\nend;\r\n$function$\n"
    },
    {
      "name": "sync_workout_set_denorm",
      "definition": "CREATE OR REPLACE FUNCTION public.sync_workout_set_denorm()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\nbegin\r\n  select w.user_id, w.performed_on\r\n    into new.user_id, new.performed_on\r\n    from public.workouts w\r\n   where w.id = new.workout_id;\r\n\r\n  if not found then\r\n    raise exception 'workout % not found', new.workout_id;\r\n  end if;\r\n\r\n  return new;\r\nend;\r\n$function$\n"
    }
  ],
