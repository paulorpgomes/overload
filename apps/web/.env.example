# Supabase project credentials — Project Settings > API.
# Both are safe to expose to the browser; Row Level Security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Anthropic API key — server-side only, NEVER prefix with NEXT_PUBLIC_.
# Used for workout text extraction and meal photo analysis. Without it, photo
# analysis returns a configuration error; the rest of the app still works.
ANTHROPIC_API_KEY=sk-ant-...

# Optional override for meal photo recognition.
ANTHROPIC_MEAL_IMAGE_MODEL=claude-sonnet-5-5
